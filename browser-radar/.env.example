# Network
HOST=127.0.0.1
PORT=4317
DATA_DIR=./data

# Optional single-token dashboard login. Leave blank for local use.
DASHBOARD_TOKEN=

# Optional low-privilege token required by the browser agent ingest endpoint.
# Do NOT reuse an admin or AI key here.
INGEST_TOKEN=

# AI provider: openai | custom | gemini | anthropic
# Any OpenAI-compatible endpoint works with AI_PROVIDER=custom and AI_BASE_URL.
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=60000

# Active security scanning is OFF by default. Enable only for targets you own
# or are explicitly authorized to test. Scans are limited to localhost/private IPs.
ALLOW_ACTIVE_SCAN=false
SCAN_MAX_PROBES=12
SCAN_TIMEOUT_MS=4000
SCAN_PROBE_DELAY_MS=150

# Limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
MAX_BODY_BYTES=12582912
MAX_FIELD_CHARS=4000
MAX_PAYLOAD_CHARS=1500000
